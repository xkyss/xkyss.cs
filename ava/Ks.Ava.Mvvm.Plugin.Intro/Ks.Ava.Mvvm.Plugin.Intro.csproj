<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyToDirectory>$(MSBuildProjectDirectory)\..\..\.build\Ks.Ava.Mvvm\bin\$(Configuration)\$(TargetFramework)\Plugins\Hello</CopyToDirectory>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Ks.Ava.Mvvm.Base\Ks.Ava.Mvvm.Base.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\IntroPage.axaml.cs">
        <DependentUpon>IntroPage.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

    <Target Name="CopyFilesToDestination" AfterTargets="Build">
        <ItemGroup>
            <FilesToCopy Include="$(OutputPath)**\Ks.Ava.Mvvm.Plugin.Intro.dll" />
            <FilesToCopy Include="$(OutputPath)**\Ks.Ava.Mvvm.Plugin.Intro.pdb" />
            <FilesToCopy Include="$(OutputPath)**\Ks.Ava.Mvvm.Plugin.Intro.deps.json" />
        </ItemGroup>
        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(CopyToDirectory)\%(RecursiveDir)" />
    </Target>
</Project>
