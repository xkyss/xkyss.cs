<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI" Version="*" />
    <PackageReference Include="Aprillz.MewUI.Platform.Win32" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MewPad.Core\MewPad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MewPad.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildAndCopySampleQuickLaunchPlugin" AfterTargets="Build">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\..\samples\QuickLaunch.Plugin\QuickLaunch.Plugin.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />

    <ItemGroup>
      <QuickLaunchPluginDll Include="$(MSBuildProjectDirectory)\..\..\.build\QuickLaunch.Plugin\bin\$(Configuration)\net10.0\QuickLaunch.Plugin.dll" />
      <QuickLaunchPluginManifest Include="$(MSBuildProjectDirectory)\..\..\samples\QuickLaunch.Plugin\plugin.json" />
    </ItemGroup>

    <MakeDir Directories="$(OutputPath)plugins\QuickLaunch" />
    <Copy
      SourceFiles="@(QuickLaunchPluginDll)"
      DestinationFolder="$(OutputPath)plugins\QuickLaunch"
      SkipUnchangedFiles="true"
      Condition="Exists('%(QuickLaunchPluginDll.Identity)')" />

    <Copy
      SourceFiles="@(QuickLaunchPluginManifest)"
      DestinationFolder="$(OutputPath)plugins\QuickLaunch"
      SkipUnchangedFiles="true"
      Condition="Exists('%(QuickLaunchPluginDll.Identity)')" />
  </Target>

  <Target Name="BuildAndCopySampleComponentsDemoPlugin" AfterTargets="Build">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\..\samples\ComponentsDemo.Plugin\ComponentsDemo.Plugin.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />

    <ItemGroup>
      <ComponentsDemoPluginDll Include="$(MSBuildProjectDirectory)\..\..\.build\ComponentsDemo.Plugin\bin\$(Configuration)\net10.0\ComponentsDemo.Plugin.dll" />
      <ComponentsDemoPluginManifest Include="$(MSBuildProjectDirectory)\..\..\samples\ComponentsDemo.Plugin\plugin.json" />
    </ItemGroup>

    <MakeDir Directories="$(OutputPath)plugins\ComponentsDemo" />
    <Copy
      SourceFiles="@(ComponentsDemoPluginDll)"
      DestinationFolder="$(OutputPath)plugins\ComponentsDemo"
      SkipUnchangedFiles="true"
      Condition="Exists('%(ComponentsDemoPluginDll.Identity)')" />

    <Copy
      SourceFiles="@(ComponentsDemoPluginManifest)"
      DestinationFolder="$(OutputPath)plugins\ComponentsDemo"
      SkipUnchangedFiles="true"
      Condition="Exists('%(ComponentsDemoPluginDll.Identity)')" />
  </Target>

</Project>
